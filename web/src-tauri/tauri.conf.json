{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Folio",
  "version": "2026.4.30",
  "identifier": "com.folio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com; img-src 'self' data: asset: http://asset.localhost https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/tmp/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt", "md", "markdown", "mdown", "mkd",
          "json", "jsonc", "json5",
          "yaml", "yml", "toml", "ini", "conf", "cfg", "properties", "env",
          "xml", "html", "htm", "xhtml", "svg",
          "css", "scss", "sass", "less",
          "js", "jsx", "ts", "tsx", "mjs", "cjs",
          "py", "pyw", "rb", "go", "rs", "java", "kt", "kts", "swift",
          "c", "h", "cpp", "cc", "cxx", "hpp", "hxx", "cs", "m", "mm",
          "php", "lua", "pl", "r", "scala", "groovy", "dart",
          "sh", "bash", "zsh", "fish", "ps1", "bat", "cmd",
          "sql", "graphql", "gql",
          "log", "csv", "tsv",
          "gradle", "gitignore", "gitattributes", "dockerfile",
          "vue", "svelte", "astro"
        ],
        "name": "Text Document",
        "description": "Editable text file",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {}
  }
}
